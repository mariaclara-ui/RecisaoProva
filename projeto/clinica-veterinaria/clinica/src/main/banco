SELECT a.data_hora, a.motivo, p.nome AS pet, p.especie, t.nome AS tutor
FROM agendamento a
JOIN pet p ON a.pet_id = p.id
JOIN tutor t ON p.tutor_id = t.id
ORDER BY a.data_hora;
